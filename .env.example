# Copy to .env and fill in. Never commit .env.

# --- Tiger Data (managed Postgres/TimescaleDB) ---
# Tiger Console -> Service -> Connection info -> "Service URL"
DATABASE_URL=postgres://tsdbadmin:CHANGE_ME@CHANGE_ME.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require

# --- Google Gemini (Phase 6) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- ElevenLabs (Phase 8) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- App ---
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Monte Carlo runs per route
SIM_RUNS=5000
# Serve precomputed demo results from backend/data/cache when true
USE_DEMO_CACHE=true

# --- Deploy (Phase 7) ---
# Set to your domain for automatic HTTPS via Caddy, or leave as :80 for plain HTTP on the public IP
SITE_ADDRESS=:80
